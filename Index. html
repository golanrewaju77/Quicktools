<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>QuickTools - Free Online Tools</title>
  <meta name="description" content="QuickTools provides free, fast and useful online calculators, converters, text tools, password tools and more.">
  <meta name="keywords" content="online tools, calculator, percentage calculator, age calculator, password generator, text counter, unit converter">
  <meta name="robots" content="index, follow">

  <meta property="og:title" content="QuickTools - Free Online Tools">
  <meta property="og:description" content="Fast and useful free online tools.">
  <meta property="og:type" content="website">

  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚡</text></svg>">

  <!-- Supabase -->
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    :root {
      --bg: #f5f7fb;
      --card: #ffffff;
      --text: #111827;
      --muted: #667085;
      --border: #e5e7eb;
      --primary: #635bff;
      --primary-dark: #5048d8;
      --success: #16a34a;
      --danger: #dc2626;
      --header: rgba(255,255,255,.92);
      --shadow: 0 10px 30px rgba(15,23,42,.08);
    }

    body.dark {
      --bg: #0b1120;
      --card: #111827;
      --text: #f8fafc;
      --muted: #94a3b8;
      --border: #263244;
      --header: rgba(11,17,32,.94);
      --shadow: 0 10px 30px rgba(0,0,0,.25);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Inter, system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.5;
      transition: background .2s, color .2s;
    }

    button, input, textarea, select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .container {
      width: min(1120px, calc(100% - 30px));
      margin: auto;
    }

    /* HEADER */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--header);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -.5px;
    }

    .logo-icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      border-radius: 11px;
      background: linear-gradient(135deg,#635bff,#8b5cf6);
      color: white;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .icon-btn, .login-btn {
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      padding: 9px 13px;
      border-radius: 10px;
    }

    .login-btn {
      background: var(--primary);
      color: white;
      border-color: var(--primary);
      font-weight: 700;
    }

    .login-btn:hover {
      background: var(--primary-dark);
    }

    /* HERO */
    .hero {
      padding: 70px 0 45px;
      text-align: center;
    }

    .badge {
      display: inline-block;
      padding: 7px 13px;
      border-radius: 999px;
      background: rgba(99,91,255,.1);
      color: var(--primary);
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(35px,7vw,62px);
      line-height: 1.05;
      letter-spacing: -2px;
      max-width: 800px;
      margin: auto;
    }

    .hero h1 span {
      color: var(--primary);
    }

    .hero p {
      color: var(--muted);
      max-width: 650px;
      margin: 18px auto 0;
      font-size: 18px;
    }

    .search-box {
      max-width: 600px;
      margin: 28px auto 0;
      position: relative;
    }

    .search-box input {
      width: 100%;
      padding: 16px 18px;
      border-radius: 14px;
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      outline: none;
      box-shadow: var(--shadow);
    }

    .search-box input:focus {
      border-color: var(--primary);
    }

    /* TOOLS */
    .section-title {
      text-align: center;
      margin: 25px 0;
    }

    .section-title h2 {
      font-size: 28px;
    }

    .section-title p {
      color: var(--muted);
      margin-top: 6px;
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    .tool-card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 17px;
      padding: 22px;
      box-shadow: var(--shadow);
      transition: transform .2s, border .2s;
    }

    .tool-card:hover {
      transform: translateY(-4px);
      border-color: rgba(99,91,255,.5);
    }

    .tool-icon {
      width: 48px;
      height: 48px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      background: rgba(99,91,255,.1);
      font-size: 24px;
      margin-bottom: 15px;
    }

    .tool-card h3 {
      font-size: 18px;
      margin-bottom: 7px;
    }

    .tool-card p {
      color: var(--muted);
      font-size: 14px;
    }

    .tool-card button {
      width: 100%;
      margin-top: 16px;
      border: 0;
      background: var(--primary);
      color: white;
      padding: 11px;
      border-radius: 10px;
      font-weight: 700;
    }

    /* FEATURES */
    .features {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      margin: 65px 0;
    }

    .feature {
      text-align: center;
      padding: 25px;
    }

    .feature-icon {
      font-size: 32px;
      margin-bottom: 10px;
    }

    .feature p {
      color: var(--muted);
      margin-top: 7px;
    }

    /* FOOTER */
    footer {
      margin-top: 60px;
      border-top: 1px solid var(--border);
      padding: 35px 0;
      color: var(--muted);
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
    }

    .footer-links {
      display: flex;
      gap: 18px;
      flex-wrap: wrap;
    }

    .footer-links a:hover {
      color: var(--primary);
    }

    /* MODALS */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 500;
      background: rgba(0,0,0,.6);
      padding: 20px;
      overflow-y: auto;
    }

    .modal.show {
      display: block;
    }

    .modal-box {
      width: min(500px, 100%);
      margin: 50px auto;
      background: var(--card);
      color: var(--text);
      border-radius: 18px;
      padding: 25px;
      box-shadow: 0 25px 70px rgba(0,0,0,.3);
      position: relative;
    }

    .modal-header {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      margin-bottom: 20px;
    }

    .close {
      border: 0;
      background: transparent;
      color: var(--muted);
      font-size: 23px;
    }

    .form-group {
      margin-bottom: 15px;
    }

    .form-group label {
      display: block;
      font-size: 14px;
      font-weight: 700;
      margin-bottom: 6px;
    }

    .form-group input,
    .form-group textarea,
    .form-group select {
      width: 100%;
      padding: 12px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--text);
      outline: none;
    }

    .primary-btn {
      width: 100%;
      border: 0;
      background: var(--primary);
      color: white;
      padding: 13px;
      border-radius: 10px;
      font-weight: 800;
    }

    .secondary-btn {
      border: 1px solid var(--border);
      background: var(--card);
      color: var(--text);
      padding: 10px 14px;
      border-radius: 9px;
    }

    .danger-btn {
      border: 0;
      background: var(--danger);
      color: white;
      padding: 11px 15px;
      border-radius: 9px;
      font-weight: 700;
      width: 100%;
    }

    .form-message {
      margin-top: 12px;
      font-size: 14px;
      color: var(--muted);
    }

    .switch {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0;
      border-bottom: 1px solid var(--border);
    }

    .switch input {
      width: 20px;
      height: 20px;
    }

    .account-card {
      padding: 16px;
      background: var(--bg);
      border-radius: 12px;
      margin-bottom: 15px;
    }

    /* TOOL WORKSPACE */
    .workspace {
      display: none;
      padding: 40px 0;
    }

    .workspace.show {
      display: block;
    }

    .workspace-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 25px;
      box-shadow: var(--shadow);
    }

    .workspace-top {
      display: flex;
      justify-content: space-between;
      gap: 15px;
      align-items: center;
      margin-bottom: 20px;
    }

    .workspace-content {
      max-width: 700px;
      margin: auto;
    }

    .result {
      margin-top: 18px;
      padding: 16px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 12px;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .two-columns {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .copy-btn {
      margin-top: 10px;
      width: 100%;
    }

    /* STATIC PAGES */
    .content-page {
      display: none;
      padding: 45px 0;
    }

    .content-page.show {
      display: block;
    }

    .content-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 28px;
      box-shadow: var(--shadow);
    }

    .content-box h1 {
      margin-bottom: 18px;
    }

    .content-box h2 {
      margin: 25px 0 8px;
    }

    .content-box p {
      color: var(--muted);
      margin-bottom: 12px;
    }

    /* RESPONSIVE */
    @media(max-width:900px) {
      .tools-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media(max-width:600px) {
      .container {
        width: min(100% - 20px, 1120px);
      }

      .nav {
        min-height: 60px;
      }

      .logo {
        font-size: 18px;
      }

      .logo-icon {
        width: 34px;
        height: 34px;
      }

      .hero {
        padding: 45px 0 30px;
      }

      .hero h1 {
        letter-spacing: -1px;
      }

      .tools-grid,
      .features {
        grid-template-columns: 1fr;
      }

      .two-columns {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

