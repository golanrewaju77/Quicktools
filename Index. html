  function closeTool() {
    showHome();
  }

  /* CALCULATIONS LOGIC */
  function calculate() {
    const input = document.getElementById("calcInput").value.trim();
    const result = document.getElementById("calcResult");
    if (!input) return (result.textContent = "Please enter a calculation.");
    if (!/^[0-9+\-*/().% ]+$/.test(input)) return (result.textContent = "Invalid characters in expression.");

    try {
      const answer = Function('"use strict"; return (' + input + ')')();
      result.textContent = "Result: " + answer;
    } catch {
      result.textContent = "Invalid calculation format.";
    }
  }

  function calculatePercentage() {
    const number = Number(document.getElementById("percentNumber").value);
    const percentage = Number(document.getElementById("percentValue").value);
    const result = document.getElementById("percentResult");

    if (!Number.isFinite(number) || !Number.isFinite(percentage)) {
      return (result.textContent = "Please enter valid numbers.");
    }
    result.textContent = `${percentage}% of ${number} = ${(number * percentage) / 100}`;
  }

  function calculateAge() {
    const value = document.getElementById("birthDate").value;
    const result = document.getElementById("ageResult");
    if (!value) return (result.textContent = "Please select a date.");

    const birth = new Date(value + "T00:00:00");
    const today = new Date();
    if (birth > today) return (result.textContent = "Birth date cannot be in the future.");

    let years = today.getFullYear() - birth.getFullYear();
    let months = today.getMonth() - birth.getMonth();
    let days = today.getDate() - birth.getDate();

    if (days < 0) {
      months--;
      days += new Date(today.getFullYear(), today.getMonth(), 0).getDate();
    }
    if (months < 0) {
      years--;
      months += 12;
    }
    result.textContent = `Age: ${years} years, ${months} months, ${days} days.`;
  }

  function generatePassword() {
    let length = Number(document.getElementById("passwordLength").value) || 16;
    length = Math.min(64, Math.max(6, length));
    const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$%^&*()_+-=[]{}";
    
    let password = "";
    const random = new Uint32Array(length);
    crypto.getRandomValues(random);
    for (let i = 0; i < length; i++) {
      password += chars[random[i] % chars.length];
    }
    document.getElementById("passwordResult").textContent = password;
  }

  function countText() {
    const text = document.getElementById("textInput").value;
    const characters = text.length;
    const words = text.trim() ? text.trim().split(/\s+/).length : 0;
    const lines = text ? text.split(/\r?\n/).length : 0;
    document.getElementById("textResult").textContent = `Characters: ${characters}\nWords: ${words}\nLines: ${lines}`;
  }

  function checkNumber() {
    const value = Number(document.getElementById("numberInput").value);
    const result = document.getElementById("numberResult");
    if (!Number.isFinite(value)) return (result.textContent = "Please enter a valid number.");

    if (Number.isInteger(value)) {
      result.textContent = `${value} is ${value % 2 === 0 ? "EVEN" : "ODD"}.`;
    } else {
      result.textContent = `${value} is a decimal/fraction.`;
    }
  }

  function convertUnit() {
    const type = document.getElementById("unitType").value;
    const value = Number(document.getElementById("unitValue").value);
    const result = document.getElementById("unitResult");
    if (!Number.isFinite(value)) return (result.textContent = "Please enter a valid number.");

    let answer, unit;
    switch (type) {
      case "kmmi": answer = value * 0.621371; unit = "miles"; break;
      case "mikm": answer = value * 1.609344; unit = "kilometres"; break;
      case "kglb": answer = value * 2.20462; unit = "pounds"; break;
      case "lbkg": answer = value * 0.453592; unit = "kilograms"; break;
      case "cf": answer = (value * 9/5) + 32; unit = "°F"; break;
      case "fc": answer = (value - 32) * 5/9; unit = "°C"; break;
    }
    result.textContent = `Result: ${Number(answer.toFixed(4))} ${unit}`;
  }

  function convertCurrency() {
    const amount = Number(document.getElementById("currencyAmount").value);
    const rate = Number(document.getElementById("currencyRate").value);
    const result = document.getElementById("currencyResult");

    if (!Number.isFinite(amount) || !Number.isFinite(rate)) {
      return (result.textContent = "Please enter valid amounts.");
    }
    result.textContent = "Converted amount: " + (amount * rate).toLocaleString(undefined, { maximumFractionDigits: 4 });
  }

  async function copyResult(id) {
    const text = document.getElementById(id).textContent.trim();
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
      alert("Copied to clipboard!");
    } catch {
      alert("Failed to copy. Please copy manually.");
    }
  }

  async function trackTool(toolName) {
    if (!supabaseClient) return;
    try {
      const { data: { user } } = await supabaseClient.auth.getUser();
      await supabaseClient.from("tool_usage").insert({
        user_id: user ? user.id : null,
        tool_name: toolName
      });
    } catch (e) {
      console.log("Analytics unavailable.");
    }
  }

  /* NAVIGATION */
  function hideAllPages() {
    document.getElementById("homePage").style.display = "none";
    document.getElementById("workspace").classList.remove("show");
    document.querySelectorAll(".content-page").forEach(page => page.classList.remove("show"));
  }

  function showHome() {
    hideAllPages();
    document.getElementById("homePage").style.display = "block";
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function showPage(id) {
    hideAllPages();
    document.getElementById(id).classList.add("show");
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function escapeHTML(str) {
    return String(str).replace(/[&<>'"]/g, 
      tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag)
    );
  }

  /* GLOBAL MODAL CLOSING LOGIC */
  document.querySelectorAll(".modal").forEach(modal => {
    modal.addEventListener("click", e => {
      if (e.target === modal) modal.classList.remove("show");
    });
  });

  document.addEventListener("keydown", e => {
    if (e.key === "Escape") {
      document.querySelectorAll(".modal").forEach(m => m.classList.remove("show"));
    }
  });
</script>

