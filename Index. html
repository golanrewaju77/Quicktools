<!-- SETTINGS MODAL -->
<div class="modal" id="settingsModal">
  <div class="modal-box">
    <div class="modal-header">
      <div>
        <h2>Settings</h2>
        <p>Manage your QuickTools preferences.</p>
      </div>
      <button class="close" onclick="closeModal('settingsModal')">×</button>
    </div>

    <div class="switch">
      <div>
        <strong>Dark Mode</strong><br>
        <small>Change the website appearance.</small>
      </div>
      <input type="checkbox" id="darkToggle" onchange="setDarkMode(this.checked)">
    </div>

    <br>

    <div class="account-card">
      <strong>Account</strong>
      <p id="accountStatus">You are not logged in.</p>
      <br>
      <button class="primary-btn" onclick="openAuth(); closeModal('settingsModal')" id="settingsAuthButton">Login / Register</button>
    </div>

    <div id="loggedInActions" style="display:none;">
      <button class="danger-btn" onclick="logout()">Logout</button>
    </div>
  </div>
</div>

<script>
  /* SUPABASE INITIALIZATION */
  const SUPABASE_URL = "https://vabrpwyjsowbgzoktxvy.supabase.co";
  const SUPABASE_KEY = "sb_publishable_AJ5Wbwx4q2yAkaaZUl-bvg_dTDNYDbP";
  
  let supabaseClient = null;
  if (window.supabase) {
    supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);
  }

  /* THEME MANAGEMENT */
  function setDarkMode(enabled) {
    document.body.classList.toggle("dark", enabled);
    localStorage.setItem("quicktools_dark", enabled ? "true" : "false");
    const toggle = document.getElementById("darkToggle");
    if (toggle) toggle.checked = enabled;
  }

  function toggleDarkMode() {
    const enabled = !document.body.classList.contains("dark");
    setDarkMode(enabled);
  }

  const savedTheme = localStorage.getItem("quicktools_dark");
  setDarkMode(savedTheme === "true");

  /* MODALS */
  function openModal(id) {
    document.getElementById(id).classList.add("show");
  }

  function closeModal(id) {
    document.getElementById(id).classList.remove("show");
  }

  function openSettings() {
    updateAccountUI();
    openModal("settingsModal");
  }

  /* AUTHENTICATION */
  let registerMode = false;

  function openAuth() {
    openModal("authModal");
    document.getElementById("authMessage").textContent = "";
  }

  function toggleAuthMode() {
    registerMode = !registerMode;
    document.getElementById("authTitle").textContent = registerMode ? "Create account" : "Login";
    document.getElementById("authSubtitle").textContent = registerMode ? "Create your free QuickTools account." : "Sign in to your QuickTools account.";
    document.getElementById("confirmPasswordGroup").style.display = registerMode ? "block" : "none";
    document.getElementById("authSubmit").textContent = registerMode ? "Create Account" : "Login";
    document.getElementById("authSwitch").textContent = registerMode ? "Already have an account? Login" : "Create an account";
    document.getElementById("authMessage").textContent = "";
  }

  document.getElementById("authForm").addEventListener("submit", async function(e) {
    e.preventDefault();
    if (!supabaseClient) {
      document.getElementById("authMessage").textContent = "Authentication is unavailable right now.";
      return;
    }

    const email = document.getElementById("authEmail").value.trim();
    const password = document.getElementById("authPassword").value;
    const message = document.getElementById("authMessage");
    const submit = document.getElementById("authSubmit");

    submit.disabled = true;
    message.textContent = "Please wait...";

    try {
      if (registerMode) {
        const confirmPassword = document.getElementById("confirmPassword").value;
        if (password !== confirmPassword) {
          throw new Error("Passwords do not match.");
        }

        const { error } = await supabaseClient.auth.signUp({
          email: email,
          password: password,
          options: { emailRedirectTo: window.location.href }
        });

        if (error) throw error;
        message.textContent = "Account created. Check your email to confirm your account.";
      } else {
        const { error } = await supabaseClient.auth.signInWithPassword({ email, password });
        if (error) throw error;

        message.textContent = "Login successful.";
        setTimeout(() => closeModal("authModal"), 700);
      }
    } catch (error) {
      message.textContent = error.message || "An error occurred.";
    } finally {
      submit.disabled = false;
    }
  });

  async function logout() {
    if (supabaseClient) await supabaseClient.auth.signOut();
    updateAccountUI();
    closeModal("settingsModal");
  }

  async function updateAccountUI() {
    if (!supabaseClient) return;

    const { data: { user } } = await supabaseClient.auth.getUser();
    const authButton = document.getElementById("authButton");
    const accountStatus = document.getElementById("accountStatus");
    const settingsAuthButton = document.getElementById("settingsAuthButton");
    const loggedInActions = document.getElementById("loggedInActions");

    if (user) {
      authButton.textContent = "Account";
      authButton.onclick = openSettings;
      accountStatus.innerHTML = "Logged in as:<br><strong>" + escapeHTML(user.email) + "</strong>";
      settingsAuthButton.style.display = "none";
      loggedInActions.style.display = "block";
    } else {
      authButton.textContent = "Login";
      authButton.onclick = openAuth;
      accountStatus.textContent = "You are not logged in.";
      settingsAuthButton.style.display = "block";
      loggedInActions.style.display = "none";
    }
  }

  if (supabaseClient) {
    supabaseClient.auth.onAuthStateChange(() => updateAccountUI());
    updateAccountUI();
  }

  /* SEARCH TOOLS */
  function searchTools() {
    const query = document.getElementById("toolSearch").value.toLowerCase().trim();
    document.querySelectorAll(".tool-card").forEach(card => {
      const name = card.dataset.name.toLowerCase();
      card.style.display = name.includes(query) ? "" : "none";
    });
  }

  /* TOOL WORKSPACE */
  function openTool(tool) {
    hideAllPages();
    document.getElementById("workspace").classList.add("show");

    const title = document.getElementById("workspaceTitle");
    const content = document.getElementById("workspaceContent");

    if (tool === "calculator") {
      title.textContent = "🧮 Calculator";
      content.innerHTML = `
        <div class="form-group">
          <label>Calculation</label>
          <input id="calcInput" placeholder="Example: 25 * 4 + 10">
        </div>
        <button class="primary-btn" onclick="calculate()">Calculate</button>
        <div class="result" id="calcResult">Your result will appear here.</div>
      `;
    } else if (tool === "percentage") {
      title.textContent = "📊 Percentage Calculator";
      content.innerHTML = `
        <div class="two-columns">
          <div class="form-group">
            <label>Number</label>
            <input id="percentNumber" type="number">
          </div>
          <div class="form-group">
            <label>Percentage (%)</label>
            <input id="percentValue" type="number">
          </div>
        </div>
        <button class="primary-btn" onclick="calculatePercentage()">Calculate</button>
        <div class="result" id="percentResult">Your result will appear here.</div>
      `;
    } else if (tool === "age") {
      title.textContent = "🎂 Age Calculator";
      content.innerHTML = `
        <div class="form-group">
          <label>Date of Birth</label>
          <input id="birthDate" type="date">
        </div>
        <button class="primary-btn" onclick="calculateAge()">Calculate Age</button>
        <div class="result" id="ageResult">Your result will appear here.</div>
      `;
    } else if (tool === "password") {
      title.textContent = "🔐 Password Generator";
      content.innerHTML = `
        <div class="form-group">
          <label>Password Length</label>
          <input id="passwordLength" type="number" min="6" max="64" value="16">
        </div>
        <button class="primary-btn" onclick="generatePassword()">Generate Password</button>
        <div class="result" id="passwordResult">Your generated password will appear here.</div>
        <button class="secondary-btn copy-btn" onclick="copyResult('passwordResult')">Copy Password</button>
      `;
    } else if (tool === "text") {
      title.textContent = "📝 Text Counter";
      content.innerHTML = `
        <div class="form-group">
          <label>Your Text</label>
          <textarea id="textInput" rows="8" placeholder="Type or paste your text..." oninput="countText()"></textarea>
        </div>
        <div class="result" id="textResult">Characters: 0\nWords: 0\nLines: 0</div>
      `;
    } else if (tool === "number") {
      title.textContent = "🔢 Number Checker";
      content.innerHTML = `
        <div class="form-group">
          <label>Number</label>
          <input id="numberInput" type="number">
        </div>
        <button class="primary-btn" onclick="checkNumber()">Check Number</button>
        <div class="result" id="numberResult">Your result will appear here.</div>
      `;
    } else if (tool === "unit") {
      title.textContent = "📏 Unit Converter";
      content.innerHTML = `
        <div class="form-group">
          <label>Conversion Type</label>
          <select id="unitType">
            <option value="kmmi">Kilometres → Miles</option>
            <option value="mikm">Miles → Kilometres</option>
            <option value="kglb">Kilograms → Pounds</option>
            <option value="lbkg">Pounds → Kilograms</option>
            <option value="cf">Celsius → Fahrenheit</option>
            <option value="fc">Fahrenheit → Celsius</option>
          </select>
        </div>
        <div class="form-group">
          <label>Value</label>
          <input id="unitValue" type="number">
        </div>
        <button class="primary-btn" onclick="convertUnit()">Convert</button>
        <div class="result" id="unitResult">Your result will appear here.</div>
      `;
    } else if (tool === "currency") {
      title.textContent = "💰 Currency Calculator";
      content.innerHTML = `
        <div class="form-group">
          <label>Amount</label>
          <input id="currencyAmount" type="number">
        </div>
        <div class="form-group">
          <label>Exchange Rate</label>
          <input id="currencyRate" type="number" step="any" placeholder="Example: 1500">
        </div>
        <button class="primary-btn" onclick="convertCurrency()">Convert</button>
        <div class="result" id="currencyResult">Your result will appear here.</div>
      `;
    }

    trackTool(tool);
